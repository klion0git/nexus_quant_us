# ==============================================================================
# Nexus US Quantitative Trading System (.env.example)
# Market Scope: US Equities, US ETFs / Treasury ETFs, CME US Index Futures
# Canonical Market Timezone: America/New_York (EDT UTC-4 / EST UTC-5)
# ==============================================================================

# Broker / Market Data Feed Provider
# Options: sandbox | yfinance | ibkr | alpaca | schwab
US_BROKER_PROVIDER=sandbox

# Alpaca Markets API (IEX / SIP)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Interactive Brokers (TWS / IB Gateway)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=10

# Charles Schwab Trader API
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=

# Target Universe & Macro Benchmark
US_TARGET_STOCKS=NVDA,AAPL,MSFT,TSLA,META,SPY,QQQ,TLT
US_MACRO_SYMBOL=ES=F

# Capital & Risk Parameters (USD)
US_INITIAL_CAPITAL=100000
US_MAX_POSITION_PCT=0.20
US_RISK_PER_TRADE_PCT=0.01
US_DAILY_LOSS_LIMIT_PCT=0.02

# Chart Workstation Web Server
US_CHART_HOST=127.0.0.1
US_CHART_PORT=8081

# Notifications
DISCORD_WEBHOOK_URL=

# Strategy Feature Toggles
US_ENABLE_BRK=true
US_ENABLE_MFO=true
US_ENABLE_MASB=true
US_ENABLE_MORPHOLOGY=true
US_ENABLE_BOND_BMR=true
US_ENABLE_MACRO_WAVE_FILTER=true
